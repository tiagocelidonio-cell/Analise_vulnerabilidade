# ---- Banco e fila ----
POSTGRES_USER=vulnscope
POSTGRES_PASSWORD=vulnscope
POSTGRES_DB=vulnscope
DATABASE_URL=postgresql+asyncpg://vulnscope:vulnscope@db:5432/vulnscope
REDIS_URL=redis://redis:6379/0

# ---- Evidencias (S3 / MinIO) ----
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=evidence

# ---- Camada de IA (Claude API) ----
# Sem a chave, o sistema roda e a IA cai num modo "stub" deterministico.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ---- Limites de seguranca do scanner ----
SCAN_MAX_CONCURRENCY=200
SCAN_CONNECT_TIMEOUT=2.0

# ---- Painel web ----
# Deixe VAZIO para o painel detectar sozinho o endereco da API (mesmo host:8000).
# So preencha se a API ficar em outro host/porta (ex: atras de proxy/dominio).
VITE_API_URL=

# ---- Autenticacao ----
# ALTERE o segredo e a senha antes de publicar em qualquer lugar acessivel!
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@vulnscope.local
ADMIN_PASSWORD=changeme

# ---- Google Dorks reais (Programmable Search API, opcional) ----
# Sem chave, a ferramenta "Google Dorks" gera o checklist de buscas.
# Com chave, ela EXECUTA os dorks e traz as exposicoes encontradas.
#   CX:  https://programmablesearchengine.google.com (marque "buscar toda a web")
#   KEY: https://developers.google.com/custom-search/v1/overview (cota gratis 100/dia)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_MAX_PER_DORK=10

# ---- Base local de CVE ----
# Bundle oficial (CVE List JSON 5.0) usado pelo "Importar base completa".
CVE_FEED_URL=https://github.com/CVEProject/cvelistV5/releases/latest/download/CVE-all.zip
# Atualizacao automatica da base (em horas). 0 = desligada (so manual pelo painel).
CVE_UPDATE_INTERVAL_HOURS=0

# ---- Monitoramento de vazamentos (Have I Been Pwned) ----
# Sem chave, a ferramenta "Vazamentos" explica como habilitar. A API e paga:
#   https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ---- API da NVD (download da base de CVE) ----
# Opcional. Sem chave funciona, mas o download e lento (5 req/30s).
# Chave gratuita (50 req/30s): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
