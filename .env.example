# ---- Banco e fila ----
POSTGRES_USER=vulnscope
POSTGRES_PASSWORD=vulnscope
POSTGRES_DB=vulnscope
DATABASE_URL=postgresql+asyncpg://vulnscope:vulnscope@db:5432/vulnscope
REDIS_URL=redis://redis:6379/0

# ---- Evidencias (S3 / MinIO) ----
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=evidence

# ---- Camada de IA (Claude API) ----
# Sem a chave, o sistema roda e a IA cai num modo "stub" deterministico.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ---- Limites de seguranca do scanner ----
SCAN_MAX_CONCURRENCY=200
SCAN_CONNECT_TIMEOUT=2.0

# ---- Painel web ----
# Deixe VAZIO para o painel detectar sozinho o endereco da API (mesmo host:8000).
# So preencha se a API ficar em outro host/porta (ex: atras de proxy/dominio).
VITE_API_URL=

# ---- Autenticacao ----
# ALTERE o segredo e a senha antes de publicar em qualquer lugar acessivel!
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@vulnscope.local
ADMIN_PASSWORD=changeme
